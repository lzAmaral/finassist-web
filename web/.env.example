# Escolha um modo: backend Go OU consulta Pluggy na Vercel.
# Sem uma configuração completa, o painel permanece vazio.
# FINASSIST_API_URL=http://127.0.0.1:3000

# Modo Pluggy: todas são privadas, de runtime, sem prefixo PUBLIC_.
# PLUGGY_CLIENT_ID=
# PLUGGY_CLIENT_SECRET=
# PLUGGY_ITEM_IDS=uuid,uuid
# BLOB_READ_WRITE_TOKEN= # token de um store Vercel Blob PRIVATE
# FINASSIST_PASSWORD_HASH= # salt hexadecimal (16 bytes):scrypt hexadecimal (64 bytes), N=16384,r=8,p=1
# FINASSIST_SESSION_KEY= # segredo aleatório de 32 bytes ou mais
# FINASSIST_DATA_KEY= # chave AES-256 em hexadecimal, 32 bytes; guardar backup
# CRON_SECRET= # segredo aleatório para o agendamento da Vercel
